# Device serial: DO NOT put MuMu / wireless ports here.
#   eval "$(bash scripts/resolve-adb-serial.sh)"   # or scripts/mumu-adb.sh
# MCP: scripts/mau-mcp-with-mumu.sh auto-detects each start.

# Default grounder model (switch per command with: mau propose ... --model glm-4.6v-flash)
MAU_GROUNDER_MODEL=gui-plus-2026-02-26

# --- Both providers can be configured at once; model pick selects the key ---
# Aliyun DashScope / gui-plus*
DASHSCOPE_API_KEY=
# MAU_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Zhipu / glm-4.6v-flash*
ZHIPU_API_KEY=
# MAU_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional single-key override (used only if family-specific key is empty):
# MAU_GROUNDER_API_KEY=
# MAU_GROUNDER_BASE_URL=

# Safety
MAU_PACKAGE_ALLOWLIST=

# Session
MAU_RUNS_DIR=runs

# Observe backend: adb (default) | u2 (requires: uv sync --extra u2)
# MAU_OBSERVE_BACKEND=adb
# MAU_OBSERVE_BACKEND=u2

# Unchanged-screen threshold inside android_run (default 3; 0=off)
# MAU_STUCK_SAME_SUMMARY=3

# Deprecated: allow propose_action(execute=true) / mau propose --execute (default off)
# MAU_ALLOW_PROPOSE_EXECUTE=1
