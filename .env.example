# Device serial: DO NOT put MuMu ports here.
#   eval "$(bash scripts/mumu-adb.sh)"
# MCP: scripts/mau-mcp-with-mumu.sh auto-detects.

# Default grounder model (switch per command with: mau propose ... --model glm-4.6v-flash)
MAU_GROUNDER_MODEL=gui-plus-2026-02-26

# --- Both providers can be configured at once; model pick selects the key ---
# Aliyun DashScope / gui-plus*
DASHSCOPE_API_KEY=
# MAU_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Zhipu / glm-4.6v-flash*
ZHIPU_API_KEY=
# MAU_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Optional single-key override (used only if family-specific key is empty):
# MAU_GROUNDER_API_KEY=
# MAU_GROUNDER_BASE_URL=

# Safety
MAU_PACKAGE_ALLOWLIST=

# Session
MAU_RUNS_DIR=runs
