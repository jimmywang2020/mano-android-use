[mcp_servers.mano-android-use]
command = "/Users/wangjinxiang/Desktop/Projects/mano-android-use/scripts/mau-mcp-with-mumu.sh"
args = []

[mcp_servers.mano-android-use.env]
MAU_GROUNDER_MODEL = "gui-plus-2026-02-26"
MAU_RUNS_DIR = "/Users/wangjinxiang/Desktop/Projects/mano-android-use/runs"
