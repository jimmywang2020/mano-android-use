# Merge into ~/.codex/config.toml (syntax may vary slightly by Codex version).
# Keys come from project .env (wrapper cd's to repo root). Do not hardcode MuMu ports.
# Replace /ABS/PATH/TO/mano-android-use with your clone path.

[mcp_servers.mano-android-use]
command = "/ABS/PATH/TO/mano-android-use/scripts/mau-mcp-with-mumu.sh"
args = []

[mcp_servers.mano-android-use.env]
MAU_GROUNDER_MODEL = "gui-plus-2026-02-26"
MAU_RUNS_DIR = "/ABS/PATH/TO/mano-android-use/runs"
